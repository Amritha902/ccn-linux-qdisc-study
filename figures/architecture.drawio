        <mxCell id="m1" value="THREE LATENCIES, measured separately&#10;&#10;sparse probe: ping at 20 Hz&#10;bulk in-band: iperf3 TCP_INFO per interval&#10;queue delay: from tc backlog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4C78A8;fontSize=10;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1">
