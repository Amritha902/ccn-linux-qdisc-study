        <mxCell id="m3" value="GENERATED OUTPUT&#10;&#10;analyse.py, analyse_law.py, plots.py&#10;every number enters LaTeX as a macro&#10;so prose cannot drift from data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F58518;fontSize=10;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1">
